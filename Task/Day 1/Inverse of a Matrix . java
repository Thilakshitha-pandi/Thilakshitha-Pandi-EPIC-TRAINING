import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        int[][] arr = new int[2][2];
        for (int i = 0; i < 2; i++) {
            for (int j = 0; j < 2; j++) {
                arr[i][j] = in.nextInt();
            }
        }
        int det = arr[0][0] * arr[1][1]
                - arr[0][1] * arr[1][0];
        if (det == 0) {
            System.out.println("Inverse does not exist");
            return;
        }
        System.out.println((double) arr[1][1] / det + " " + (double) -arr[0][1] / det);
        System.out.println((double) -arr[1][0] / det + " " + (double) arr[0][0] / det);
    }
}
