import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        String str = in.nextLine();
        String str2 = "";
        for (int i = 0 ; i < str.length() ; i++){
            str2 = str2 + str.charAt(i);
        }
        System.out.println(str2);
    }
}
