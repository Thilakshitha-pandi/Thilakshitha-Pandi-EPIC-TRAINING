public class Main
{
	public static void main(String[] args) {
	    Scanner in = new Scanner(System.in);
	    Customer cus = new Customer();
	    Product pro = new Product();
		while(true){
		    System.out.println("1)Create Customer \n 2)Display Customer \n3)Get Customer by ID \n4)Create Product \n5)Display Product \n6)Get Product by ID");
		    int n = in.nextInt();
		    switch(n){
		        case 1:{
		            cus.createCustomer();
		            break;
		        }
		        case 2:{
		            cus.displayCustomer();
		            break;
		        }
		        case 3:{
		            cus.GetCusbyID();
		            break;
		        }
		        case 4:{
		            pro.createProduct();
		            break;
		        }case 5:{
		            pro.displayProduct();
		            break;
		        }
		        case 6:{
		            pro.GetProbyID();
		            break;
		        }default{
		            System.out.println("invalid");
		        }
		    }
		}
	}
}

